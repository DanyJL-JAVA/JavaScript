
const users = [
    { id: 1, name: "John" },
    { id: 2, name: "Jane" },
    { id: 1, name: "John" },
    { id: 3, name: "Mike" },
    { id: 2, name: "Jane" }
];


const arr = [...new Map(users.map((user) => [user.id,user])).values()];

console.log('Using Map => ');
console.log(arr);

// new Map() => To Convert the Array to Map in 'key' & 'value' pairs.
// [...] => Finally, the spread Operator Converts the Map to array.
// .map() => set the id -> Key | and id + name (user) -> value
// .values() => extracting the value pair separtely from map and return to result.

//*Note : A Map stores unique keys.When a duplicate key appears, the latest value replaces the old one.
// 1.Removes duplicates based on id.
// 2.Keeps the last object when duplicate IDs exist.
// 3.Time complexity: O(n).
 
 /////////////////////Other Way using =>  Set + Filter /////////////////////////////////


const hashset = new Set();

const array = [...users.filter((user) => {


if(hashset.has(user.id)){

return false;

}

hashset.add(user.id);

return true;


})];

console.log('Using Set => ');
console.log(array);

// Time Complexity : O(n) First occurrence


