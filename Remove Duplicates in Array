let arr = [10, 20, 30, 10, 20, 40, 50];

let array = [...new Set(arr)];

console.log(array); // result : [ 10, 20, 30, 40, 50 ]

// // Bescause we use "SET", Time Compleity : O(n).

// Note : 
// new Set(arr) stores only unique values.
// [... ] (Spread operator) converts the Set back into an array.


